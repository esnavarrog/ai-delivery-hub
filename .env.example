# Copy to .env for local development (apps/server loads it only when NODE_ENV != production).
DATABASE_URL=postgres://hub:hub@localhost:5433/hub
# Integration tests run only when this is set (see infra/docker-compose.yml, database hub_test).
DATABASE_URL_TEST=postgres://hub:hub@localhost:5433/hub_test

OP_BASE_URL=https://openproject.example.com
OP_API_KEY=replace-me
OP_WEBHOOK_SECRET=replace-me

# Defaults to packages/policies when unset.
POLICIES_DIR=
PORT=3000
# Polling fallback interval; pg-boss schedules are cron based, so this is rounded to whole minutes (min 1).
POLL_INTERVAL_MS=120000

# --- AI runs (Phase 1 step 4) ---
# Claude credentials are resolved by the Anthropic SDKs: ANTHROPIC_API_KEY, or a profile from `ant auth login` / `claude` login.
ANTHROPIC_API_KEY=
# auto (default) | subscription | api-key. auto picks api-key when ANTHROPIC_API_KEY is set, else subscription.
# subscription reuses the logged-in Claude Code CLI session and is for personal/dev use only;
# production and multi-user deployments must use api-key (Anthropic's terms).
AI_CREDENTIALS=auto
# Enforced: with NODE_ENV=production, startup fails unless AI_CREDENTIALS resolves to api-key
# (auto without a key, or explicit subscription, both refuse to start). Outside production,
# an auto fallback to subscription logs one warn-level line.
# Root for bare git mirrors + detached read-only worktrees used by planning runs. Defaults to <repo-root>/.worktrees (gitignored).
WORKTREES_DIR=
# Public URL of the web app; used in the OpenProject comment "AI plan vN ready for review: <url>/tickets/<id>/plan".
HUB_PUBLIC_URL=http://localhost:5173
# Optional explicit path to the Claude Code binary used by the Agent SDK (defaults to the SDK's bundled lookup).
CLAUDE_CODE_PATH=
